# Placeholders only. Real values live in .env (git-ignored), and in Azure Key Vault from Phase 7.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=thalam
POSTGRES_USER=thalam
POSTGRES_PASSWORD=change-me

# Model router (ADR-0006, Accepted; hosted model on Microsoft Foundry, ADR-0012)
LLM_LOCAL_BASE_URL=http://localhost:11434
LLM_LOCAL_MODEL=<local-model>
LLM_HOSTED_PROVIDER=<foundry-anthropic|foundry-openai>
LLM_HOSTED_MODEL=<model-id>                # the Foundry deployment name; R13 counts tokens on it
LLM_MONTHLY_TOKEN_BUDGET_USD=<number>      # at most 10 (about Rs 950, below the Rs 1,000 model budget; ADR-0013)

# Observability (ADR-0004)
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-placeholder
LANGFUSE_SECRET_KEY=sk-placeholder
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Read-only accounts (agent) — sandboxes only. Checked by `make sandboxes` (SPEC-001-R10..R13).
# Quote a value that contains " #" (e.g. a password), or it is read as a comment.
# Jira: the SANDBOX site, never the planning site (ADR-0011). Scoped token, read scopes only.
JIRA_SANDBOX_CLOUD_ID=<cloud-id>          # from https://<your-sandbox>.atlassian.net/_edge/tenant_info
JIRA_SANDBOX_EMAIL=<bot-account-email>
JIRA_READ_TOKEN=placeholder
SERVICENOW_BASE_URL=https://<your-pdi>.service-now.com
SERVICENOW_READ_USER=placeholder           # has snc_read_only
SERVICENOW_READ_PASSWORD=placeholder

# Write accounts (executor only)
JIRA_WRITE_TOKEN=placeholder
SERVICENOW_WRITE_USER=placeholder
SERVICENOW_WRITE_PASSWORD=placeholder

# Slack
SLACK_BOT_TOKEN=xoxb-placeholder
SLACK_APP_TOKEN=xapp-placeholder

# Hosted model: Claude on Microsoft Foundry (ADR-0012), names as the Anthropic SDK reads them.
# The resource NAME only, not its address; budgets of Rs 1,500 and Rs 1,000 exist before the deployment.
ANTHROPIC_FOUNDRY_RESOURCE=<your-resource> # https://<your-resource>.services.ai.azure.com
ANTHROPIC_FOUNDRY_API_KEY=placeholder

# Azure guardrails (ADR-0014): where every budget alert and the brake's notice are e-mailed.
# `make guardrails-plan` passes it, and the resource name above, to Terraform as TF_VAR_*.
THALAM_ALERT_EMAIL=you@example.com

# Anthropic's attestation fields (Lab 00 step 3). Azure signs Anthropic's Marketplace offer with
# them on every Claude deployment, so they must describe the real organization that uses the model.
CLAUDE_ORGANIZATION_NAME=<your-organization>
CLAUDE_COUNTRY_CODE=<two-letter-code>      # ISO 3166-1, such as IN
CLAUDE_INDUSTRY=technology                 # lower case, as the Foundry portal's list
