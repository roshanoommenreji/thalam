{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(az account show:*)",
      "Bash(az group list:*)",
      "Bash(az group show:*)",
      "Bash(az cognitiveservices account list:*)",
      "Bash(az cognitiveservices account show:*)",
      "Bash(az cognitiveservices account deployment list:*)",
      "Bash(az cognitiveservices account deployment show:*)",
      "Bash(az consumption budget list:*)",
      "Bash(az consumption budget show:*)",
      "Bash(az resource list:*)",
      "Bash(az policy assignment list:*)",
      "Bash(az policy assignment show:*)",
      "Bash(az monitor action-group show:*)",
      "Bash(az rest --method get:*)",

      "Bash(terraform fmt:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform plan:*)",
      "Bash(terraform output:*)",
      "Bash(terraform init:*)",

      "Bash(kubectl get:*)",
      "Bash(kubectl describe:*)",
      "Bash(kubectl logs:*)",
      "Bash(kubectl top:*)",
      "Bash(kubectl explain:*)",
      "Bash(helm list:*)",
      "Bash(helm template:*)",
      "Bash(helm lint:*)",
      "Bash(helm diff:*)",

      "Bash(docker ps:*)",
      "Bash(docker images:*)",
      "Bash(docker logs:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",

      "Bash(make help:*)",
      "Bash(make test:*)",
      "Bash(make lint:*)",
      "Bash(make azure-sweep:*)",
      "Bash(make foundry-status:*)",
      "Bash(make foundry-down:*)",
      "Bash(make guardrails-plan:*)",

      "Bash(ruff check:*)",
      "Bash(mypy:*)",
      "Bash(pytest:*)",
      "Bash(opa test:*)",
      "Bash(gitleaks git:*)",
      "Bash(gitleaks dir:*)"
    ],
    "ask": [
      "Bash(terraform apply:*)",
      "Bash(make guardrails-apply:*)",
      "Bash(make foundry-up:*)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl apply:*)",
      "Bash(make up:*)",
      "Bash(make down:*)",
      "Bash(make nuke:*)",
      "Bash(make lab-up:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(az cognitiveservices account keys list:*)",
      "Bash(az policy assignment delete:*)",
      "Bash(az policy exemption create:*)",
      "Bash(az consumption budget delete:*)",
      "Bash(az monitor action-group delete:*)",
      "Bash(az rest --method delete:*)",
      "Bash(az rest --method DELETE:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform -chdir=infra/envs/azure destroy:*)"
    ]
  }
}
